{
  "$comment": "secret-write-guard rules, gitleaks-shaped: id · description · regex (JS syntax, compiled with `flags`, default g) · optional entropy (Shannon bits/char floor over capture group 1, else the whole match) · optional keywords (case-insensitive pre-filter: the rule runs only when one appears in the text). Placeholder values (EXAMPLE, changeme, xxxx, REDACTED, <…>, ${…}) and decoys (40/64-hex SHAs, UUIDs) are exempted in code, not here. Edit with a must-fire AND a must-not-fire case in secret-write-guard.test.mjs.",
  "rules": [
    {
      "id": "aws-access-key-id",
      "description": "AWS access key id (AKIA + 16 upper-alphanumerics)",
      "regex": "\\bAKIA[0-9A-Z]{16}\\b"
    },
    {
      "id": "github-token",
      "description": "GitHub personal/OAuth/user/server/refresh token (ghp_/gho_/ghu_/ghs_/ghr_ + 36 or more)",
      "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b"
    },
    {
      "id": "gitlab-pat",
      "description": "GitLab personal access token (glpat- + 20 or more)",
      "regex": "\\bglpat-[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "id": "slack-token",
      "description": "Slack bot/app/user/refresh/config token (xox[baprs]-)",
      "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b"
    },
    {
      "id": "stripe-live-key",
      "description": "Stripe live secret or restricted key (sk_live_ / rk_live_)",
      "regex": "\\b[sr]k_live_[A-Za-z0-9]{10,}\\b"
    },
    {
      "id": "google-api-key",
      "description": "Google API key (AIza + 35)",
      "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b"
    },
    {
      "id": "private-key-pem",
      "description": "PEM private key header (RSA/EC/OPENSSH/DSA/PGP or unqualified)",
      "regex": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP |ENCRYPTED )?PRIVATE KEY"
    },
    {
      "id": "npm-token",
      "description": "npm access token (npm_ + 36)",
      "regex": "\\bnpm_[A-Za-z0-9]{36}\\b"
    },
    {
      "id": "anthropic-api-key",
      "description": "Anthropic API key (sk-ant-)",
      "regex": "\\bsk-ant-[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "id": "openai-api-key",
      "description": "OpenAI API key (sk-proj- or sk- + 40 or more)",
      "regex": "\\bsk-(?:proj-)?[A-Za-z0-9_-]{40,}\\b"
    },
    {
      "id": "twilio-api-key",
      "description": "Twilio API key SID (SK + 32 hex)",
      "regex": "\\bSK[0-9a-f]{32}\\b"
    },
    {
      "id": "sendgrid-api-key",
      "description": "SendGrid API key (SG.<22>.<43>)",
      "regex": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}\\b"
    },
    {
      "id": "discord-bot-token",
      "description": "Discord bot token (base64 id . timestamp . hmac)",
      "regex": "\\b[MN][A-Za-z0-9]{23,}\\.[A-Za-z0-9_-]{6}\\.[A-Za-z0-9_-]{27,}\\b"
    },
    {
      "id": "jwt",
      "description": "JSON Web Token (three base64url segments, header starts eyJ)",
      "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b"
    },
    {
      "id": "generic-credential",
      "description": "api_key / secret / token / password assigned a high-entropy value of 20 or more chars",
      "regex": "\\b(?:api[_-]?key|apikey|access[_-]?key|secret(?:[_-]?key)?|auth[_-]?token|token|password|passwd|pwd)\\b\\s*[:=]\\s*['\"]?([A-Za-z0-9_\\-+/=.~!@#$%^&*]{20,})",
      "flags": "gi",
      "entropy": 3.5,
      "keywords": ["key", "secret", "token", "password", "passwd", "pwd"]
    }
  ]
}
